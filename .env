# ─── CRYPTO BOT - Variables d'environnement ─────────────────────────
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS commiter .env sur GitHub !

# ─── IA (Semaine 2) ─────────────────────────────────────────────────
# Option A : Gemini gratuit → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option B : Claude → https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── Alertes (Semaine 3) ────────────────────────────────────────────
# Discord : Serveur → Paramètres → Intégrations → Webhooks → Créer
DISCORD_WEBHOOK_URL=

# Gmail : Compte Google → Sécurité → Mots de passe d'application
GMAIL_SENDER=
GMAIL_PASSWORD=
GMAIL_RECIPIENT=
